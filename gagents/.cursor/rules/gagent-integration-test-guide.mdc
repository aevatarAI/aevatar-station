{
    // Arrange - Verify Orleans cluster is running
    ClusterClient.ShouldNotBeNull();
    
    // Act - Test silo connectivity and GAgent factory
    var testAgent = await GAgentFactory.GetGAgentAsync<IMyGAgent>(Guid.NewGuid());
    
