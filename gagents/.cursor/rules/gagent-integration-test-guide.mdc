### 5.1 End-to-End Workflow with External Dependencies
```csharp
[Fact]
public async Task System_EndToEndWorkflowWithExternalAPIs_ShouldProcessCorrectly()
{
    // Arrange - Setup complete system with external service mocks
    var system = await new IntegrationTestSystemBuilder(GAgentFactory, GetRequiredService<ITestDataSeeder>())
        .BuildCompleteSystemAsync();
    
    // Configure external service mocks
    var httpClientFactory = GetRequiredService<IHttpClientFactory>();
    var mockServer = new MockHttpServer(); // Assuming a mock server setup
    
