### 3.2 Multi-Agent System Setup for Integration Testing
```csharp
public class IntegrationTestSystemBuilder
{
    private readonly IGAgentFactory _gAgentFactory;
    private readonly ITestDataSeeder _dataSeeder;
    
    public IntegrationTestSystemBuilder(IGAgentFactory gAgentFactory, ITestDataSeeder dataSeeder)
    {
        _gAgentFactory = gAgentFactory;
        _dataSeeder = dataSeeder;
    }
    
    public async Task<ComplexTestSystem> BuildCompleteSystemAsync()
    {
        // Seed required data first
        await _dataSeeder.SeedAsync();
        
        // Create system coordinator with persistent state
        var coordinator = await _gAgentFactory.GetGAgentAsync<IWorkflowCoordinatorGAgent>(
            new Guid("10000000-0000-0000-0000-000000000001"));
        
        // Create specialized worker agents
        var workers = new List<IWorkerGAgent>();
        for (int i = 0; i < 5; i++)
        {
            var workerId = new Guid($"20000000-0000-0000-0000-00000000000{i + 1}");
            var worker = await _gAgentFactory.GetGAgentAsync<IWorkerGAgent>(workerId);
            await worker.ConfigureAsync(new WorkerConfiguration 
            { 
                WorkerType = $"TestWorker{i + 1}",
                MaxConcurrentTasks = 10
            });
            workers.Add(worker);
        }
        
        // Create monitoring and health check agents
        var monitor = await _gAgentFactory.GetGAgentAsync<ISystemMonitorGAgent>(
            new Guid("30000000-0000-0000-0000-000000000001"));
        
        var healthCheck = await _gAgentFactory.GetGAgentAsync<IHealthCheckGAgent>(
            new Guid("30000000-0000-0000-0000-000000000002"));
        
        // Establish agent relationships and communication
        foreach (var worker in workers)
        {
            await coordinator.RegisterWorkerAsync(worker);
            await monitor.RegisterForMonitoringAsync(worker);
        }
        
        await monitor.RegisterForMonitoringAsync(coordinator);
        await healthCheck.StartHealthChecksAsync();
        
        // Initialize complete system
        await coordinator.InitializeWorkflowSystemAsync();
        await monitor.StartSystemMonitoringAsync();
        
        // Wait for system stabilization
        await Task.Delay(2000);
        
        return new ComplexTestSystem
        {
            Coordinator = coordinator,
            Workers = workers.ToArray(),
            Monitor = monitor,
            HealthCheck = healthCheck
        };
    }
}

public class ComplexTestSystem
{
    public IWorkflowCoordinatorGAgent Coordinator { get; set; }
    public IWorkerGAgent[] Workers { get; set; }
    public ISystemMonitorGAgent Monitor { get; set; }
    public IHealthCheckGAgent HealthCheck { get; set; }
    
    public async Task<SystemHealthReport> GetSystemHealthAsync()
    {
        return await HealthCheck.GetCurrentHealthReportAsync();
    }
    
    public async Task ShutdownAsync()
    {
        await Monitor.StopMonitoringAsync();
        await HealthCheck.StopHealthChecksAsync();
        await Coordinator.ShutdownAsync();
    }
}
```

## Part 4: Integration Test Scenarios

### 4.1 Database Integration and Storage Testing
```csharp
[Fact]
public async Task System_DatabaseIntegration_ShouldPersistDataCorrectly()
{
    // Arrange - Setup complete system with database
    var system = await new IntegrationTestSystemBuilder(GAgentFactory, GetRequiredService<ITestDataSeeder>())
        .BuildCompleteSystemAsync();
    
    var database = GetRequiredService<IMongoDatabase>();
    var workflowCollection = database.GetCollection<WorkflowExecution>("workflow_executions");
    
    // Act - Execute workflow that involves database operations
    var workflowRequest = new WorkflowExecutionRequest
    {
        WorkflowId = "test-complex-workflow",
        InputData = new Dictionary<string, object>
        {
            ["testData"] = "integration test execution",
            ["executionId"] = Guid.NewGuid().ToString()
        }
    };
    
    var executionId = await system.Coordinator.StartWorkflowAsync(workflowRequest);
    
    // Wait for workflow completion
    await WaitForWorkflowCompletionAsync(system.Coordinator, executionId, TimeSpan.FromMinutes(2));
    
    // Assert - Verify database state
    var storedExecution = await workflowCollection
        .Find(e => e.Id == executionId)
        .FirstOrDefaultAsync();
    
    storedExecution.ShouldNotBeNull();
    storedExecution.Status.ShouldBe(WorkflowStatus.Completed);
    storedExecution.Steps.Count.ShouldBeGreaterThan(0);
    
    // Verify all agents updated their persistent state
    foreach (var worker in system.Workers)
    {
        var workerState = await worker.GetStateAsync();
        workerState.ProcessedWorkflows.ShouldContain(executionId);
    }
    
    _testOutputHelper.WriteLine($"Workflow {executionId} completed and persisted successfully");
    
    await system.ShutdownAsync();
}

private async Task WaitForWorkflowCompletionAsync(IWorkflowCoordinatorGAgent coordinator, string executionId, TimeSpan timeout)
{
    var stopwatch = Stopwatch.StartNew();
    while (stopwatch.Elapsed < timeout)
    {
        var status = await coordinator.GetWorkflowStatusAsync(executionId);
        if (status.IsCompleted)
            return;
        
        await Task.Delay(500);
    }
    
    throw new TimeoutException($"Workflow {executionId} did not complete within {timeout}");
}
```

### 4.2 System Performance and Load Testing
```csharp
[Fact]
public async Task System_ConcurrentLoad_ShouldHandleMultipleWorkflows()
{
    // Arrange - Setup system for load testing
    var system = await new IntegrationTestSystemBuilder(GAgentFactory, GetRequiredService<ITestDataSeeder>())
        .BuildCompleteSystemAsync();
    
    const int concurrentWorkflows = 50;
    var executionTasks = new List<Task<string>>();
    
    // Act - Execute multiple workflows concurrently
    for (int i = 0; i < concurrentWorkflows; i++)
    {
        var workflowRequest = new WorkflowExecutionRequest
        {
            WorkflowId = "test-simple-workflow",
            InputData = new Dictionary<string, object>
            {
                ["testIndex"] = i,
                ["concurrentTest"] = true
            }
        };
        
        executionTasks.Add(system.Coordinator.StartWorkflowAsync(workflowRequest));
    }
    
    var executionIds = await Task.WhenAll(executionTasks);
    
    // Wait for all workflows to complete
    var completionTasks = executionIds.Select(id => 
        WaitForWorkflowCompletionAsync(system.Coordinator, id, TimeSpan.FromMinutes(5)));
    
    await Task.WhenAll(completionTasks);
    
    // Assert - Verify system handled load correctly
    var systemHealth = await system.GetSystemHealthAsync();
    systemHealth.OverallHealth.ShouldBe(HealthStatus.Healthy);
    systemHealth.ProcessedWorkflows.ShouldBe(concurrentWorkflows);
    
    // Verify all workers participated
    foreach (var worker in system.Workers)
    {
        var workerState = await worker.GetStateAsync();
        workerState.ProcessedWorkflows.Count.ShouldBeGreaterThan(0);
    }
    
    _testOutputHelper.WriteLine($"Successfully processed {concurrentWorkflows} concurrent workflows");
    _testOutputHelper.WriteLine($"System health: {systemHealth.OverallHealth}");
    
    await system.ShutdownAsync();
}
```

### 4.3 System Resilience and Recovery Testing
```csharp
[Fact]
public async Task System_AgentFailure_ShouldRecoverGracefully()
{
    // Arrange - Setup system with monitoring
    var system = await new IntegrationTestSystemBuilder(GAgentFactory, GetRequiredService<ITestDataSeeder>())
        .BuildCompleteSystemAsync();
    
    // Start a long-running workflow
    var workflowRequest = new WorkflowExecutionRequest
    {
        WorkflowId = "test-complex-workflow",
        InputData = new Dictionary<string, object>
        {
            ["resilience_test"] = true,
            ["delay_steps"] = true
        }
    };
    
    var executionId = await system.Coordinator.StartWorkflowAsync(workflowRequest);
    
    // Wait for workflow to start processing
    await Task.Delay(1000);
    
    // Act - Simulate worker failure by deactivating grain
    var failingWorker = system.Workers[0];
    var failingWorkerId = await failingWorker.GetIdAsync();
    
    // Force deactivation to simulate failure
    var grainManagement = ClusterClient.GetGrain<IManagementGrain>(0);
    await grainManagement.ForceGarbageCollection(TimeSpan.Zero);
    
    // Wait for system to detect failure and recover
    await Task.Delay(5000);
    
    // Assert - Verify system recovered
    var systemHealth = await system.GetSystemHealthAsync();
    systemHealth.FailedAgents.ShouldContain(failingWorkerId);
    
    // Verify workflow continued on other workers
    var workflowStatus = await system.Coordinator.GetWorkflowStatusAsync(executionId);
    workflowStatus.Status.ShouldBeOneOf(WorkflowStatus.Running, WorkflowStatus.Completed);
    
    // Wait for workflow completion
    await WaitForWorkflowCompletionAsync(system.Coordinator, executionId, TimeSpan.FromMinutes(3));
    
    var finalStatus = await system.Coordinator.GetWorkflowStatusAsync(executionId);
    finalStatus.Status.ShouldBe(WorkflowStatus.Completed);
    
    _testOutputHelper.WriteLine($"System recovered from worker failure and completed workflow {executionId}");
    
    await system.ShutdownAsync();
}
```

