[Fact]
public async Task MultiSiloCluster_AgentCommunication_ShouldWorkAcrossSilos()
{
    // Arrange - This test requires special cluster configuration for multiple silos
    // Note: This test may require additional setup in ClusterFixture for multi-silo testing
    
    var system = await new IntegrationTestSystemBuilder(GAgentFactory, GetRequiredService<ITestDataSeeder>())
