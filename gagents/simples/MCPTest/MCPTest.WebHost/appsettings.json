{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MCPTest.WebHost.Services.RealMCPTestService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "MCPServerOptions": {
    "EnableAllMCPServers": false,
    "ResetWhitelistEverytime": true,
    "MCPServers": {
      "filesystem": {
        "ServerName": "filesystem",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp", "/Users"],
        "Description": "File system operations",
        "Type": "Stdio"
      },
      "memory": {
        "ServerName": "memory",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-memory"],
        "Description": "Knowledge graph memory system",
        "Type": "Stdio"
      },
      "sequential-thinking": {
        "ServerName": "sequential-thinking",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
        "Description": "Structured reasoning framework",
        "Type": "Stdio"
      },
      "fetch": {
        "ServerName": "fetch",
        "Command": "uvx",
        "Args": ["mcp-server-fetch"],
        "Description": "Network resource acquisition tool",
        "Type": "Stdio"
      },
      "time": {
        "ServerName": "time",
        "Command": "uvx",
        "Args": ["mcp-server-time"],
        "Description": "Time and date management system",
        "Type": "Stdio"
      },
      "github": {
        "ServerName": "github",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-github"],
        "Description": "GitHub integration",
        "Type": "Stdio",
        "Env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "github-mcp-server": {
        "ServerName": "github",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "enescinar-twitter": {
        "ServerName": "enescinar-twitter",
        "Command": "npx", 
        "Args": ["-y", "@enescinar/twitter-mcp@latest"],
        "Description": "Twitter integration",
        "Type": "Stdio",
        "Env": {
          "API_KEY": "${TWITTER_API_KEY}",
          "API_SECRET_KEY": "${TWITTER_API_SECRET_KEY}",
          "ACCESS_TOKEN": "${TWITTER_ACCESS_TOKEN}",
          "ACCESS_TOKEN_SECRET": "${TWITTER_ACCESS_TOKEN_SECRET}"
        }
      }
    }
  }
}
