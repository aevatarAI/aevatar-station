### 2.2 State Persistence and Event Sourcing Integration Test
```csharp
[Fact]
public async Task GAgent_StatePersistence_ShouldPersistAcrossActivations()
{
    // Arrange - Create agent and perform state changes
    var agentId = Guid.NewGuid();
    var myAgent = await GAgentFactory.GetGAgentAsync<IMyGAgent>(agentId);
    
    // Act - Perform multiple state-changing operations
    await myAgent.UpdateStateAsync("initial value");
    await myAgent.AddItemAsync("item1");
    await myAgent.AddItemAsync("item2");
    
    // Wait for state persistence
    await WaitForEventPropagationAsync();
    
    // Force deactivation and reactivation by getting new reference
    var reactivatedAgent = await GAgentFactory.GetGAgentAsync<IMyGAgent>(agentId);
    
    // Assert - Verify state persisted correctly through Orleans storage
    var state = await reactivatedAgent.GetStateAsync();
    state.Value.ShouldBe("initial value");
    state.Items.Count.ShouldBe(2);
    state.Items.ShouldContain("item1");
    state.Items.ShouldContain("item2");
    
    // Verify event sourcing worked correctly
    state.EventHistory.Count.ShouldBeGreaterThan(0);
    
    _testOutputHelper.WriteLine($"State persisted correctly with {state.EventHistory.Count} events");
    foreach (var eventItem in state.EventHistory.Take(5))
    {
        _testOutputHelper.WriteLine($"Event: {eventItem}");
    }
}
```

### 2.3 Multi-Agent Event Communication Integration Test
```csharp
[Fact]
public async Task MultiAgent_EventCommunication_ShouldPropagateAcrossSystem()
{
    // Arrange - Setup complex multi-agent system
    var system = await SetupTestSystemAsync();
    
    var publisher = system.Coordinator;
    var subscribers = system.Workers;
    
    // Act - Publish complex event with payload
    var testEvent = new WorkflowStartedEvent 
    { 
        WorkflowId = Guid.NewGuid().ToString(),
        Data = "integration test workflow",
        Priority = EventPriority.High,
        Metadata = new Dictionary<string, string>
        {
            ["source"] = "integration_test",
            ["environment"] = "test"
        }
    };
    
    await publisher.PublishAsync(testEvent);
    
    // Wait for event propagation across Orleans cluster
    await WaitForEventPropagationAsync(2000);
    
    // Assert - Verify event received and processed by all subscribers
    foreach (var subscriber in subscribers)
    {
    var subscriberState = await subscriber.GetStateAsync();
        subscriberState.ReceivedEvents.ShouldContain(e => e.WorkflowId == testEvent.WorkflowId);
        subscriberState.ProcessedWorkflows.ShouldContain(testEvent.WorkflowId);
    }
    
    // Verify coordinator state updated correctly
    var coordinatorState = await publisher.GetStateAsync();
    coordinatorState.PublishedEvents.ShouldContain(e => e.WorkflowId == testEvent.WorkflowId);
    coordinatorState.ActiveWorkflows.ShouldContain(testEvent.WorkflowId);
    
    _testOutputHelper.WriteLine($"Event propagated to {subscribers.Length} agents successfully");
    _testOutputHelper.WriteLine($"Coordinator tracking {coordinatorState.ActiveWorkflows.Count} active workflows");
}
```

