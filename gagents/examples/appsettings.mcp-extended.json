{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "MCPServerOptions": {
    "EnableAllMCPServers": false,
    "ResetWhitelistEverytime": true,
    "MCPServers": {
      // === 核心工具服务器 ===
      "filesystem": {
        "ServerName": "filesystem",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp", "/Users"],
        "Description": "File system operations with secure path access",
        "Type": "Stdio"
      },
      "memory": {
        "ServerName": "memory",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-memory"],
        "Description": "Knowledge graph memory system for information storage",
        "Type": "Stdio"
      },
      "sequential-thinking": {
        "ServerName": "sequential-thinking",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
        "Description": "Structured reasoning framework for complex problem solving",
        "Type": "Stdio"
      },

      // === 网络和API服务器 ===
      "fetch": {
        "ServerName": "fetch",
        "Command": "uvx",
        "Args": ["mcp-server-fetch"],
        "Description": "Network resource acquisition and HTTP client",
        "Type": "Stdio"
      },
      "brave-search": {
        "ServerName": "brave-search",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-brave-search"],
        "Description": "Privacy-focused web search using Brave Search API",
        "Type": "Stdio",
        "Env": {
          "BRAVE_SEARCH_API_KEY": "${BRAVE_SEARCH_API_KEY}"
        }
      },

      // === 开发工具服务器 ===
      "github": {
        "ServerName": "github",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-github"],
        "Description": "GitHub integration for repository management",
        "Type": "Stdio",
        "Env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "gitlab": {
        "ServerName": "gitlab",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-gitlab"],
        "Description": "GitLab integration for repository management",
        "Type": "Stdio",
        "Env": {
          "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}",
          "GITLAB_API_URL": "${GITLAB_API_URL}"
        }
      },
      "git": {
        "ServerName": "git",
        "Command": "uvx",
        "Args": ["mcp-server-git"],
        "Description": "Git version control operations",
        "Type": "Stdio"
      },

      // === 数据库服务器 ===
      "postgres": {
        "ServerName": "postgres",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-postgres"],
        "Description": "PostgreSQL database integration with read-only access",
        "Type": "Stdio",
        "Env": {
          "DATABASE_URL": "${POSTGRES_DATABASE_URL}"
        }
      },
      "sqlite": {
        "ServerName": "sqlite",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-sqlite"],
        "Description": "SQLite database integration",
        "Type": "Stdio",
        "Env": {
          "SQLITE_DATABASE_PATH": "${SQLITE_DATABASE_PATH}"
        }
      },

      // === 云服务集成 ===
      "google-maps": {
        "ServerName": "google-maps",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-google-maps"],
        "Description": "Google Maps API integration for location services",
        "Type": "Stdio",
        "Env": {
          "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
        }
      },
      "slack": {
        "ServerName": "slack",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-slack"],
        "Description": "Slack workspace integration for team communication",
        "Type": "Stdio",
        "Env": {
          "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}"
        }
      },

      // === 社交媒体服务器 ===
      "twitter": {
        "ServerName": "twitter",
        "Command": "npx",
        "Args": ["-y", "@enescinar/twitter-mcp@latest"],
        "Description": "Twitter/X integration for social media operations",
        "Type": "Stdio",
        "Env": {
          "API_KEY": "${TWITTER_API_KEY}",
          "API_SECRET_KEY": "${TWITTER_API_SECRET_KEY}",
          "ACCESS_TOKEN": "${TWITTER_ACCESS_TOKEN}",
          "ACCESS_TOKEN_SECRET": "${TWITTER_ACCESS_TOKEN_SECRET}"
        }
      },

      // === 监控和分析 ===
      "sentry": {
        "ServerName": "sentry",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-sentry"],
        "Description": "Application monitoring and error tracking",
        "Type": "Stdio",
        "Env": {
          "SENTRY_DSN": "${SENTRY_DSN}"
        }
      },

      // === 自动化工具 ===
      "puppeteer": {
        "ServerName": "puppeteer",
        "Command": "npx",
        "Args": ["-y", "@modelcontextprotocol/server-puppeteer"],
        "Description": "Browser automation and web scraping",
        "Type": "Stdio"
      },

      // === 时间和日期 ===
      "time": {
        "ServerName": "time",
        "Command": "uvx",
        "Args": ["mcp-server-time"],
        "Description": "Time and date management system with timezone support",
        "Type": "Stdio"
      },

      // === AI和语言模型 ===
      "context7": {
        "ServerName": "context7",
        "Command": "npx",
        "Args": ["-y", "@upstash/context7-mcp@latest"],
        "Description": "Context-aware document and code management system",
        "Type": "Stdio"
      },

      // === 自定义企业服务器 ===
      "company-crm": {
        "ServerName": "company-crm",
        "Url": "https://crm-api.company.com/mcp/sse",
        "Description": "Company CRM system integration via SSE",
        "Type": "StreamableHttp",
        "Headers": {
          "Authorization": "Bearer ${COMPANY_CRM_API_KEY}",
          "X-Tenant-ID": "${COMPANY_CRM_TENANT_ID}",
          "Accept": "text/event-stream",
          "Cache-Control": "no-cache"
        }
      },
      "internal-kb": {
        "ServerName": "internal-kb",
        "Url": "https://kb-api.internal.company.com/mcp/stream",
        "Description": "Internal knowledge base search and retrieval",
        "Type": "StreamableHttp",
        "Headers": {
          "X-API-Key": "${INTERNAL_KB_ACCESS_TOKEN}",
          "Content-Type": "application/json",
          "User-Agent": "MCPGAgent/1.0"
        }
      },
      "workflow-engine": {
        "ServerName": "workflow-engine",
        "Command": "node",
        "Args": ["/opt/company/workflow-mcp-server/index.js"],
        "Description": "Company workflow automation engine",
        "Type": "Stdio",
        "Env": {
          "WORKFLOW_DB_CONNECTION": "${WORKFLOW_DB_CONNECTION}",
          "WORKFLOW_SERVICE_URL": "${WORKFLOW_SERVICE_URL}"
        }
      },

      // === 第三方SaaS集成 ===
      "salesforce": {
        "ServerName": "salesforce",
        "Url": "https://${SALESFORCE_INSTANCE_URL}/services/data/v60.0/mcp/stream",
        "Description": "Salesforce CRM integration via SSE",
        "Type": "StreamableHttp",
        "Headers": {
          "Authorization": "Bearer ${SALESFORCE_ACCESS_TOKEN}",
          "X-SFDC-Session": "${SALESFORCE_SESSION_ID}",
          "Accept": "text/event-stream",
          "Sforce-Query-Options": "batchSize=200"
        }
      },
      "jira": {
        "ServerName": "jira",
        "Command": "npx",
        "Args": ["-y", "@company/jira-mcp-server"],
        "Description": "Atlassian Jira project management integration",
        "Type": "Stdio",
        "Env": {
          "JIRA_BASE_URL": "${JIRA_BASE_URL}",
          "JIRA_USERNAME": "${JIRA_USERNAME}",
          "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
        }
      },
      "confluence": {
        "ServerName": "confluence",
        "Command": "npx",
        "Args": ["-y", "@company/confluence-mcp-server"],
        "Description": "Atlassian Confluence wiki and documentation",
        "Type": "Stdio",
        "Env": {
          "CONFLUENCE_BASE_URL": "${CONFLUENCE_BASE_URL}",
          "CONFLUENCE_USERNAME": "${CONFLUENCE_USERNAME}",
          "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
        }
      },

      // === 开发和测试工具 ===
      "docker": {
        "ServerName": "docker",
        "Command": "npx",
        "Args": ["-y", "@company/docker-mcp-server"],
        "Description": "Docker container management and operations",
        "Type": "Stdio",
        "Env": {
          "DOCKER_HOST": "${DOCKER_HOST}"
        }
      },
      "kubernetes": {
        "ServerName": "kubernetes",
        "Command": "npx",
        "Args": ["-y", "@company/k8s-mcp-server"],
        "Description": "Kubernetes cluster management",
        "Type": "Stdio",
        "Env": {
          "KUBECONFIG": "${KUBECONFIG}",
          "K8S_NAMESPACE": "${K8S_NAMESPACE}"
        }
      },

      // === 数据处理服务器 ===
      "elasticsearch": {
        "ServerName": "elasticsearch",
        "Url": "https://elasticsearch.company.com:9200/_mcp/stream",
        "Description": "Elasticsearch search and analytics engine via SSE",
        "Type": "StreamableHttp",
        "Headers": {
          "Authorization": "Basic ${ELASTICSEARCH_AUTH_TOKEN}",
          "Content-Type": "application/json",
          "X-Elastic-Product": "Elasticsearch",
          "Accept": "text/event-stream"
        }
      },
      "redis": {
        "ServerName": "redis",
        "Command": "npx",
        "Args": ["-y", "@company/redis-mcp-server"],
        "Description": "Redis cache and data structure operations",
        "Type": "Stdio",
        "Env": {
          "REDIS_URL": "${REDIS_URL}"
        }
      },

      // === 文档和内容管理 ===
      "notion": {
        "ServerName": "notion",
        "Command": "npx",
        "Args": ["-y", "@company/notion-mcp-server"],
        "Description": "Notion workspace and documentation management",
        "Type": "Stdio",
        "Env": {
          "NOTION_INTEGRATION_TOKEN": "${NOTION_INTEGRATION_TOKEN}"
        }
      },
      "sharepoint": {
        "ServerName": "sharepoint",
        "Url": "https://graph.microsoft.com/v1.0/mcp/events",
        "Description": "Microsoft SharePoint document management via Graph API SSE",
        "Type": "StreamableHttp",
        "Headers": {
          "Authorization": "Bearer ${SHAREPOINT_ACCESS_TOKEN}",
          "Content-Type": "application/json",
          "ConsistencyLevel": "eventual",
          "Accept": "text/event-stream",
          "X-Client-SKU": "MCPGAgent",
          "X-Client-Version": "1.0"
        }
      },

      // === 实时数据流服务器 ===
      "zhipu-web-search-sse": {
        "ServerName": "zhipu-web-search-sse",
        "Url": "https://open.bigmodel.cn/api/mcp/web_search/sse?Authorization=${ZHIPU_API_KEY}",
        "Description": "Zhipu AI web search with real-time streaming results",
        "Type": "StreamableHttp",
        "Headers": {
          "Accept": "text/event-stream",
          "Cache-Control": "no-cache",
          "Connection": "keep-alive"
        }
      },
      "realtime-stock-data": {
        "ServerName": "realtime-stock-data",
        "Url": "https://api.financialdata.com/v2/mcp/stream",
        "Description": "Real-time stock market data streaming",
        "Type": "StreamableHttp",
        "Headers": {
          "X-API-Key": "${FINANCIAL_DATA_API_KEY}",
          "Accept": "text/event-stream",
          "X-Stream-Type": "quotes",
          "X-Market": "US"
        }
      },
      "iot-sensor-stream": {
        "ServerName": "iot-sensor-stream",
        "Url": "wss://iot.company.com/sensors/mcp/stream",
        "Description": "IoT sensor data real-time streaming",
        "Type": "StreamableHttp",
        "Headers": {
          "Authorization": "Bearer ${IOT_ACCESS_TOKEN}",
          "X-Device-Type": "all",
          "X-Data-Format": "json"
        }
      }
    }
  }
}
