private async Task SetupECommerceSystem()
{
    // Create coordinator
    var coordinator = await _gAgentFactory.GetGAgentAsync<IECommerceCoordinatorGAgent>();
    
    // Create all agents
    var orderAgent = await _gAgentFactory.GetGAgentAsync<IOrderGAgent>();
