{
  "ConnectionStrings": {
    "Default": "mongodb://localhost:27017/Aevatar"
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:8308/"
      }
    }
  },
  "Orleans": {
    "ClusterId": "AevatarSiloCluster",
    "ServiceId": "AevatarBasicService",
    "DataBase": "AevatarDb"
  },
  "OpenTelemetry": {
    "ServiceName": "Aevatar.HttpApi.Host",
    "ServiceVersion": "1.0.0"
  },
  "Redis": {
    "Configuration": "http://127.0.0.1:6379"
  },
  "Serilog": {
    "Properties": {
      "Application": "Aevatar.Developer.Host"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/log-.log",
          "formatter": {
            "type": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ]
  },
  "Host": {
    "HostId": "Aevatar",
    "Version": "Version"
  },
  "ZooKeeper": {
    "ConnectionString": ""
  },
  "DebugMode": {
    "ExecuteRecordMode": true
  },
  "MCPGateway": {
    "GatewayBaseUrl": "http://localhost:8000",
    "AuthToken": "",
    "RequestTimeout": "00:00:30",
    "EnableSessionAffinity": true,
    "MaxRetryAttempts": 3,
    "RetryDelay": "00:00:01",
    "DefaultHeaders": {
      "User-Agent": "Aevatar-Developer-Host/1.0"
    }
  }
}